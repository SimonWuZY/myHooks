{
  "name": "@simonzywu/react-hooks-collection",
  "version": "1.0.0",
  "description": "A collection of useful React hooks with TypeScript support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run check",
    "check": "node scripts/pre-publish-check.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "react",
    "hooks",
    "typescript",
    "fetch",
    "debounce",
    "toggle",
    "localstorage",
    "sse",
    "server-sent-events",
    "utilities"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/react-hooks-collection.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/react-hooks-collection/issues"
  },
  "homepage": "https://github.com/your-username/react-hooks-collection#readme",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "rollup": "^3.29.5",
    "rollup-plugin-dts": "^5.3.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
